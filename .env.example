# Copiar a .env.local y completar con valores reales (.env.local nunca se commitea).

# Generar con: npx auth secret
AUTH_SECRET=

# Google Cloud Console -> OAuth Client ID (tipo "Web application")
# Redirect URI local: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel -> Storage -> Postgres (conectar el proyecto inyecta esto automáticamente en producción;
# para desarrollo local, copiar el valor desde el dashboard de Vercel)
DATABASE_URL=
